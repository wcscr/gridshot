# GPU exposed to the segmentation service through NVIDIA CDI.
# Use nvidia.com/gpu=all or a specific index/UUID on multi-GPU hosts.
GRIDSHOT_GPU_DEVICE=nvidia.com/gpu=0

# Optional model and runtime settings.
GRIDSHOT_SAM=sam2
GRIDSHOT_INFERENCE_QUEUE_SIZE=2
HF_TOKEN=

# The native macOS launcher also reads this file. Variables already exported by
# the invoking shell take precedence.

# Optional native Metal checkpoint overrides. Defaults are validated commits
# recorded in the source.
# GRIDSHOT_SAM_REVISION=
# GRIDSHOT_SAM3_REVISION=

# Accelerator selection: auto prefers CUDA, then Apple Metal/MPS, then CPU. The
# native macOS launcher fails closed unless this resolves to MPS.
GRIDSHOT_ACCELERATOR=auto

# auto uses BF16 on CUDA and FP32 on MPS/CPU. Validate a lower precision on the
# retained capture corpus before overriding the Metal default.
GRIDSHOT_DTYPE=auto

# Native macOS requires unsupported MPS operations to fail instead of silently
# running on CPU.
PYTORCH_ENABLE_MPS_FALLBACK=0

# Optional native macOS path overrides. Leave commented to use repository-local
# configuration, model caches, and the loopback inference service.
# GRIDSHOT_CONFIG_DIR=/absolute/path/to/gridshot-config
# GRIDSHOT_SEGSERVER_URL=http://127.0.0.1:8801
# HF_HUB_CACHE=/absolute/path/to/huggingface-cache
# TORCH_HOME=/absolute/path/to/torch-cache
