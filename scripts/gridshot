#!/usr/bin/env bash
# Run the GridShot CLI through the host's supported runtime.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ "$(uname -s)" == "Darwin" ]]; then
    if [[ "$(uname -m)" != "arm64" ]]; then
        echo "GridShot's native macOS runtime requires Apple Silicon (arm64)." >&2
        exit 1
    fi
    exec "$script_dir/gridshot-macos" "$@"
fi

cd "$(dirname "$(readlink -f "$0")")/.."
exec docker compose run --rm cli gridshot "$@"
