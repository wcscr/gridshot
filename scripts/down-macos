#!/usr/bin/env bash
# Stop GridShot services started by scripts/up-macos.
set -euo pipefail

repo_dir="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_dir"

stop_service() {
    local name="$1"
    local expected="$2"
    local pid_file="config/run/$name.pid"

    if [[ ! -f "$pid_file" ]]; then
        echo "$name is not running."
        return
    fi
    local pid
    pid="$(tr -dc '0-9' < "$pid_file")"
    if [[ -z "$pid" ]]; then
        echo "Ignoring invalid $pid_file." >&2
        rm -f "$pid_file"
        return
    fi
    local command_line
    command_line="$(ps -p "$pid" -o command= 2>/dev/null || true)"
    if [[ "$command_line" != *"$expected"* ]]; then
        echo "Ignoring stale $pid_file; PID $pid is not $name." >&2
        rm -f "$pid_file"
        return
    fi
    kill "$pid"
    for _ in {1..40}; do
        if ! kill -0 "$pid" 2>/dev/null; then
            break
        fi
        sleep 0.25
    done
    if kill -0 "$pid" 2>/dev/null; then
        echo "$name did not stop after 10 seconds (PID $pid)." >&2
        return 1
    fi
    rm -f "$pid_file"
    echo "Stopped $name."
}

stop_service web gridshot.server.app:app
stop_service segserver gridshot.segserver.main:app
